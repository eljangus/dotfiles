# kitty terminal config — Niri/Noctalia desktop on Arch
# theme selection: noctalia generates its own kitty theme at runtime via
# templates; this repo ships one-dark/rose-pine/rose-pine-dawn as static
# fallbacks. Point `include` below at whichever you want.

font_family      Maple Mono NF
font_size        14.0

allow_remote_control socket-only
listen_on        unix:/tmp/kitty-{kitty_pid}
background_blur  0
background_opacity 1
confirm_os_window_close 0
cursor_trail     5
hide_window_decorations no
macos_titlebar_color background
placement_strategy top-left
resize_debounce_time 0 0
scrollbar        never
window_padding_width 20

map shift+ctrl+backspace change_font_size all 14
map shift+ctrl+minus     change_font_size all -2.0
map shift+ctrl+plus      change_font_size all +2.0
map shift+ctrl+i         previous_window
map shift+ctrl+o         next_window

# BEGIN_KITTY_THEME
# Tokyo Night Moon
include current-theme.conf
# END_KITTY_THEME
