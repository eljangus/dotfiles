layout {

    focus-ring {
        active-color   "#5f6370"
        inactive-color "#edeef2"
        urgent-color   "#525666"
    }

    border {
        active-color   "#5f6370"
        inactive-color "#edeef2"
        urgent-color   "#525666"
    }


    tab-indicator {
        active-color   "#5f6370"
        inactive-color "#aeb7d3"
        urgent-color   "#525666"
    }

    insert-hint {
        color "#5f637080"
    }
}

recent-windows {
    highlight {
        active-color "#5f6370"
        urgent-color "#525666"
    }
}
