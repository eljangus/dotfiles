layout {

    focus-ring {
        active-color   "#aa1a8d"
        inactive-color "#fff8f9"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#aa1a8d"
        inactive-color "#fff8f9"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#aa1a8d"
        inactive-color "#f863d0"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#aa1a8d80"
    }
}

recent-windows {
    highlight {
        active-color "#aa1a8d"
        urgent-color "#ba1a1a"
    }
}
