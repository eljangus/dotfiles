layout {

    focus-ring {
        active-color   "#22444d"
        inactive-color "#faf9f9"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#22444d"
        inactive-color "#faf9f9"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#22444d"
        inactive-color "#3a5c65"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#22444d80"
    }
}

recent-windows {
    highlight {
        active-color "#22444d"
        urgent-color "#ba1a1a"
    }
}
