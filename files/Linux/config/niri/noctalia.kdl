layout {

    focus-ring {
        active-color   "#c0c8cd"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c0c8cd"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c0c8cd"
        inactive-color "#8a9297"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c0c8cd80"
    }
}

recent-windows {
    highlight {
        active-color "#c0c8cd"
        urgent-color "#ffb4ab"
    }
}
