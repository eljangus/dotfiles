n    --error-bg-color: #b66467;\n    --error-fg-color: #151515;\n    --error-color: #b66467;\n\n    --window-bg-color: #151515;\n    --window-fg-color: #e8e3e3;\n\n    --view-bg-color: #151515;\n    --view-fg-color: #e8e3e3;\n\n    --headerbar-bg-color: #151515;\n    --headerbar-fg-color: #e8e3e3;\n    --headerbar-backdrop-color: @window_bg_color;\n\n    --popover-bg-color: #222222;\n    --popover-fg-color: #e8e3e3;\n\n    --card-bg-color: #222222;\n    --card-fg-color: #e8e3e3;\n\n    --dialog-bg-color: #151515;\n    --dialog-fg-color: #e8e3e3;\n\n    --overview-bg-color: #222222;\n    --overview-fg-color: #e8e3e3;\n\n    --sidebar-bg-color: #222222;\n    --sidebar-fg-color: #e8e3e3;\n    --sidebar-backdrop-color: @window_bg_color;\n    --sidebar-border-color: @window_bg_color;\n\n    --warning-bg-color: #512d58;\n    --warning-fg-color: #e9e0eb;\n    --warning-color: #a988b0;\n\n    --success-color: #8aa6a2;\n    --success-bg-color: #2e4f4b;\n    --success-fg-color: #e2e9e8;\n    \n    --shade-color: rgba(0, 0, 0, 0.36);\n}\n\n","registerMode":0}]],["1",[{"text":"","registerMode":1}]]]}