;;; sequoia-monochrome-light-theme.el --- Sequoia Monochrome Light -*- lexical-binding: t -*-

;; Palette: Sequoia Monochrome Light by Micheal Andreuzza (MIT)
;; https://github.com/Sequoia-Theme

;;; Code:

(deftheme sequoia-monochrome-light
  "Sequoia Monochrome Light.")

(let ((bg        "#edeef2")
      (fg        "#282930")
      (cursor    "#5f6370")
      (selection "#d5d5df")
      (black     "#d4d5dc")
      (red       "#525666")
      (green     "#2e3038")
      (yellow    "#50535e")
      (blue      "#5f6370")
      (magenta   "#25262d")
      (cyan      "#454752")
      (white     "#282930")
      (gray      "#42434e"))
  (custom-theme-set-faces
   'sequoia-monochrome-light

   ;; Basics
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,cursor))))
   `(region ((t (:background ,selection :extend t))))
   `(secondary-selection ((t (:background ,black :extend t))))
   `(hl-line ((t (:background ,black :extend t))))
   `(highlight ((t (:background ,selection))))
   `(fringe ((t (:background ,bg :foreground ,gray))))
   `(vertical-border ((t (:foreground ,black))))
   `(window-divider ((t (:foreground ,black))))
   `(shadow ((t (:foreground ,gray))))
   `(minibuffer-prompt ((t (:foreground ,blue :weight bold))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,cyan :underline t))))
   `(match ((t (:background ,selection :foreground ,yellow))))
   `(isearch ((t (:background ,blue :foreground ,bg :weight bold))))
   `(isearch-fail ((t (:background ,red :foreground ,bg))))
   `(lazy-highlight ((t (:background ,selection :foreground ,magenta))))
   `(show-paren-match ((t (:background ,selection :foreground ,magenta :weight bold))))
   `(show-paren-mismatch ((t (:background ,red :foreground ,bg :weight bold))))
   `(trailing-whitespace ((t (:background ,red))))
   `(error ((t (:foreground ,red :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(success ((t (:foreground ,green :weight bold))))
   `(tooltip ((t (:background ,black :foreground ,fg))))
   `(header-line ((t (:background ,black :foreground ,fg))))

   ;; Line numbers
   `(line-number ((t (:foreground ,gray))))
   `(line-number-current-line ((t (:foreground ,fg :weight bold))))

   ;; Mode line
   `(mode-line ((t (:background ,black :foreground ,fg :box (:line-width 4 :color ,black)))))
   `(mode-line-inactive ((t (:background ,bg :foreground ,gray :box (:line-width 4 :color ,bg)))))
   `(mode-line-buffer-id ((t (:foreground ,magenta :weight bold))))
   `(mode-line-emphasis ((t (:foreground ,magenta :weight bold))))
   `(mode-line-highlight ((t (:foreground ,blue))))

   ;; Syntax
   `(font-lock-keyword-face ((t (:foreground ,magenta :weight bold))))
   `(font-lock-builtin-face ((t (:foreground ,cyan))))
   `(font-lock-function-name-face ((t (:foreground ,yellow))))
   `(font-lock-function-call-face ((t (:foreground ,yellow))))
   `(font-lock-variable-name-face ((t (:foreground ,fg))))
   `(font-lock-type-face ((t (:foreground ,cyan))))
   `(font-lock-constant-face ((t (:foreground ,red))))
   `(font-lock-number-face ((t (:foreground ,red))))
   `(font-lock-string-face ((t (:foreground ,green))))
   `(font-lock-doc-face ((t (:foreground ,gray :slant italic))))
   `(font-lock-comment-face ((t (:foreground ,gray :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,gray :slant italic))))
   `(font-lock-preprocessor-face ((t (:foreground ,blue))))
   `(font-lock-negation-char-face ((t (:foreground ,magenta))))
   `(font-lock-warning-face ((t (:foreground ,yellow :weight bold))))

   ;; Completion (vertico, orderless, corfu)
   `(completions-common-part ((t (:foreground ,blue :weight bold))))
   `(completions-first-difference ((t (:foreground ,magenta))))
   `(vertico-current ((t (:background ,selection :extend t))))
   `(orderless-match-face-0 ((t (:foreground ,blue :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,magenta :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,cyan :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,yellow :weight bold))))
   `(corfu-default ((t (:background ,black :foreground ,fg))))
   `(corfu-current ((t (:background ,selection :foreground ,magenta))))
   `(corfu-border ((t (:background ,gray))))
   `(corfu-bar ((t (:background ,gray))))

   ;; Diagnostics (flymake, eglot)
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,blue)))))
   `(eglot-highlight-symbol-face ((t (:background ,selection))))

   ;; Diff / magit
   `(diff-added ((t (:foreground ,green :extend t))))
   `(diff-removed ((t (:foreground ,red :slant italic :extend t))))
   `(diff-changed ((t (:foreground ,yellow :extend t))))
   `(diff-refine-added ((t (:background ,selection :foreground ,magenta))))
   `(diff-refine-removed ((t (:background ,selection :foreground ,red))))
   `(diff-header ((t (:background ,black :foreground ,fg))))
   `(diff-file-header ((t (:background ,black :foreground ,magenta :weight bold))))
   `(magit-section-highlight ((t (:background ,black :extend t))))
   `(magit-diff-added ((t (:foreground ,green :extend t))))
   `(magit-diff-added-highlight ((t (:background ,black :foreground ,green :extend t))))
   `(magit-diff-removed ((t (:foreground ,red :slant italic :extend t))))
   `(magit-diff-removed-highlight ((t (:background ,black :foreground ,red :slant italic :extend t))))
   `(magit-diff-context-highlight ((t (:background ,black :foreground ,fg :extend t))))
   `(magit-diff-hunk-heading ((t (:background ,black :foreground ,gray :extend t))))
   `(magit-diff-hunk-heading-highlight ((t (:background ,selection :foreground ,fg :extend t))))
   `(magit-branch-local ((t (:foreground ,blue))))
   `(magit-branch-remote ((t (:foreground ,cyan))))
   `(magit-hash ((t (:foreground ,gray))))

   ;; Org
   `(org-level-1 ((t (:foreground ,magenta :weight bold))))
   `(org-level-2 ((t (:foreground ,yellow :weight bold))))
   `(org-level-3 ((t (:foreground ,cyan :weight bold))))
   `(org-level-4 ((t (:foreground ,blue :weight bold))))
   `(org-level-5 ((t (:foreground ,red))))
   `(org-level-6 ((t (:foreground ,green))))
   `(org-level-7 ((t (:foreground ,fg))))
   `(org-level-8 ((t (:foreground ,gray))))
   `(org-document-title ((t (:foreground ,magenta :weight bold))))
   `(org-document-info ((t (:foreground ,cyan))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,gray :weight bold))))
   `(org-headline-done ((t (:foreground ,gray))))
   `(org-date ((t (:foreground ,blue :underline t))))
   `(org-code ((t (:foreground ,green))))
   `(org-verbatim ((t (:foreground ,green))))
   `(org-block ((t (:background ,black :extend t))))
   `(org-block-begin-line ((t (:background ,black :foreground ,gray :extend t))))
   `(org-block-end-line ((t (:background ,black :foreground ,gray :extend t))))
   `(org-meta-line ((t (:foreground ,gray))))
   `(org-table ((t (:foreground ,cyan))))
   `(org-link ((t (:foreground ,blue :underline t))))

   ;; Dired
   `(dired-directory ((t (:foreground ,blue :weight bold))))
   `(dired-symlink ((t (:foreground ,cyan))))
   `(dired-marked ((t (:foreground ,magenta :weight bold))))
   `(dired-flagged ((t (:foreground ,red :weight bold))))

   ;; Terminal colors (eat, compilation buffers)
   `(ansi-color-black ((t (:foreground ,black :background ,black))))
   `(ansi-color-red ((t (:foreground ,red :background ,red))))
   `(ansi-color-green ((t (:foreground ,green :background ,green))))
   `(ansi-color-yellow ((t (:foreground ,yellow :background ,yellow))))
   `(ansi-color-blue ((t (:foreground ,blue :background ,blue))))
   `(ansi-color-magenta ((t (:foreground ,magenta :background ,magenta))))
   `(ansi-color-cyan ((t (:foreground ,cyan :background ,cyan))))
   `(ansi-color-white ((t (:foreground ,white :background ,white))))
   `(ansi-color-bright-black ((t (:foreground ,gray :background ,gray))))
   `(ansi-color-bright-red ((t (:foreground ,red :background ,red))))
   `(ansi-color-bright-green ((t (:foreground ,green :background ,green))))
   `(ansi-color-bright-yellow ((t (:foreground ,yellow :background ,yellow))))
   `(ansi-color-bright-blue ((t (:foreground ,blue :background ,blue))))
   `(ansi-color-bright-magenta ((t (:foreground ,magenta :background ,magenta))))
   `(ansi-color-bright-cyan ((t (:foreground ,cyan :background ,cyan))))
   `(ansi-color-bright-white ((t (:foreground ,white :background ,white))))))

(provide-theme 'sequoia-monochrome-light)

;;; sequoia-monochrome-light-theme.el ends here
